{
  "name": "daymark-todo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "harness:check": "node .harness/engine/bin/install.mjs --check",
    "harness:doctor": "node .harness/engine/bin/harness.mjs doctor",
    "harness:install": "node .harness/engine/bin/install.mjs",
    "harness:setup": "git submodule update --init --recursive && npm ci && npm run harness:install && npm run harness:check && npm run harness:doctor",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^26.1.0",
    "oxlint": "1.81.0",
    "typescript": "~6.0.2",
    "vite": "^7.3.0",
    "vitest": "4.1.11"
  }
}
