{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated acceptance scenarios",
  "type": "object",
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "given", "when", "then", "method", "priority"]
      }
    }
  }
}
