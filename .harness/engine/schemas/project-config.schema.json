{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harness-validations-org/harness-demo/schemas/project-config.schema.json",
  "title": "Harness Demo project configuration",
  "type": "object",
  "required": ["schemaVersion", "project", "commands", "evaluation", "safety"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "required": ["lint", "test", "build"],
      "properties": {
        "install": { "type": "string" },
        "lint": { "type": "string" },
        "test": { "type": "string" },
        "build": { "type": "string" },
        "serve": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["browser", "baseUrl", "maxRepairAttempts", "requireNoConsoleErrors"]
    },
    "safety": {
      "type": "object",
      "required": ["allowedPaths", "forbiddenPaths", "maxChangedFiles"]
    }
  }
}
